{
  "$schema": "https://raw.githubusercontent.com/Azure/azure-dev/main/schemas/v1.0/azure.parameters.json",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": { "value": "${AZURE_APP_NAME=loginsight}" },
    "location": { "value": "${AZURE_LOCATION=eastus2}" },
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "dbAdminLogin": { "value": "${DB_ADMIN_LOGIN=loginsightadmin}" },
    "dbAdminPassword": { "value": "${DB_ADMIN_PASSWORD}" },
    "jwtSecret": { "value": "${JWT_SECRET}" },
    "seedAdminEmail": { "value": "${SEED_ADMIN_EMAIL=admin@loginsight.local}" },
    "seedAdminPassword": { "value": "${SEED_ADMIN_PASSWORD}" },
    "foundryEndpoint": { "value": "${AZURE_AI_FOUNDRY_ENDPOINT=}" },
    "foundryApiKey": { "value": "${AZURE_AI_FOUNDRY_API_KEY=}" },
    "foundryDeployment": { "value": "${AZURE_AI_FOUNDRY_DEPLOYMENT=gpt-4o-mini}" }
  }
}

# =====================================================================
# traceiq — environment variables (example)
# Author: Matthew Faber
# =====================================================================
# Copy this file to `.env` for local development. In Azure, these values
# come from Container App secrets backed by Key Vault references.

# ---- API server ----
PORT=4000
NODE_ENV=development

# ---- Auth ----
# Random 32+ char string. Used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string-please-32chars-min
# Initial admin user seeded on first start. Change the password!
SEED_ADMIN_EMAIL=admin@traceiq.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---- Database ----
# Local Docker default. In Azure, this becomes the Flexible Server conn string.
DATABASE_URL=postgresql://traceiq:traceiq_dev_password@localhost:5432/traceiq

# ---- Blob storage ----
# Local default uses Azurite. In Azure, point to the real account.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER=logs

# ---- Azure AI Foundry ----
# Created in your Foundry project. Endpoint looks like:
#   https://<project-name>.services.ai.azure.com/models
# The deployment name is the friendly name you chose when deploying
# gpt-4o-mini inside your Foundry project.
AZURE_AI_FOUNDRY_ENDPOINT=https://your-project.services.ai.azure.com/models
AZURE_AI_FOUNDRY_API_KEY=replace-with-key-from-foundry-project
AZURE_AI_FOUNDRY_DEPLOYMENT=gpt-4o-mini

# ---- Frontend ----
# The browser uses this URL to call the API. In local dev, it's localhost.
# In Azure, set this to the API Container App's FQDN at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
